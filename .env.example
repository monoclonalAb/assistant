HERMES_DATA_DIR=/Users/eric/.hermes-docker
# Jarvis's memory vault, and the only host directory Hermes can write.
# Keep it out of ~/Desktop and ~/Documents (iCloud sync, macOS privacy prompts).
# Create it with `make vault-init`.
HERMES_PROJECT_DIR=/Users/eric/jarvis-vault
# IANA timezone for cron schedules and timestamps.
JARVIS_TIMEZONE=Pacific/Auckland

# Where failure alerts go (nightly job, backups), e.g. bluebubbles:+64211234567.
# Set it once Jarvis can text you, then `make notify-test` and `make dream-reinstall`.
JARVIS_NOTIFY=

# Nightly memory consolidation (apply changes with `make dream-reinstall`).
JARVIS_DREAM_SCHEDULE=0 4 * * *
JARVIS_DREAM_REASONING=high
# Optional: pin a stronger model than chat uses (names from `make model`).
JARVIS_DREAM_MODEL=
JARVIS_DREAM_PROVIDER=openai-codex

# Vault backup (`make vault-backup-setup`). Blank = git@github.com:<your gh user>/jarvis-vault.git.
JARVIS_BACKUP_REMOTE=
JARVIS_BACKUP_HOUR=5
